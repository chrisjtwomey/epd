{
  "name": "EpdBoardInkplate",
  "version": "0.23.2",
  "description": "IBoard implementation for Soldered/e-radionica Inkplate panels. Kept separate from EpdClient so projects on other hardware never pull in InkplateLibrary.",
  "keywords": "epaper, eink, inkplate",
  "license": "MIT",
  "authors": [
    {
      "name": "Chris Twomey"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisjtwomey/epd.git"
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": [
    "EpdBoardInkplate.h"
  ],
  "dependencies": [
    {
      "owner": "chrisjtwomey",
      "name": "EpdClient",
      "version": "^0.23.2"
    },
    {
      "owner": "e-radionicacom",
      "name": "InkplateLibrary",
      "version": "^11.0.0"
    },
    {
      "owner": "bitbank2",
      "name": "PNGdec",
      "version": "^1.1.6"
    }
  ],
  "build": {
    "extraScript": "scripts/png_line_buffer.py"
  }
}
